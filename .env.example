# Firebase web app config (Vite exposes VITE_* vars to the client at build time)
#
# Local development:
#   cp .env.example .env.local
#
# Production builds (Firebase Hosting deploy):
#   cp .env.example .env.production
#
# Never commit .env.local or .env.production — they contain real project secrets.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Gemini (Cloud Functions only — do NOT add VITE_GEMINI_* to the client)
# Production: firebase functions:secrets:set GEMINI_API_KEY
# Local emulator: create functions/.secret.local with GEMINI_API_KEY=...
# See README.md → Cloud Functions secrets
